{
    "id": "de.f1ori.longlens",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "longlens",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--talk-name=org.freedesktop.secrets"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "modules/freerdp.json",
        {
            "name": "longlens",
            "builddir": true,
            "buildsystem": "meson",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin",
                "env": {
                    "CARGO_NET_OFFLINE": "true"
                }
            },
            "run-tests": true,
            "config-opts": [
                "--buildtype=release"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/f1ori/longlens.git",
                    "tag": "v1.1.0",
                    "commit": "a836e78df922d6934f7a8c75848c02aa77ff7f30"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir .cargo",
                        "cp cargo/config .cargo/"
                    ]
                }
            ]
        }
    ]
}